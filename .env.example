# Specter · Variables de entorno
# Copia este archivo a .env (frontend) y NUNCA lo commitees con valores reales.

# --- Supabase (frontend, cliente anónimo) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (solo backend / CI: migraciones, seed, tareas administrativas) ---
# FIX: la service_role key bypassa RLS por diseño. Nunca debe llegar al bundle
# del frontend ni a un repo público; vive únicamente como secret de Supabase /
# variable de entorno del backend (n8n, edge functions).
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (orquestación IA, Fase 3) ---
N8N_WEBHOOK_URL=
# Secreto compartido para firmar/verificar HMAC-SHA256 del payload que el
# frontend envía al webhook de n8n. Vive como secret en n8n y en la Edge
# Function que firma la petición; nunca en el bundle del cliente.
SPECTER_WEBHOOK_SECRET=

# --- Pasarela de pagos: Mercado Pago (Fase 4) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
